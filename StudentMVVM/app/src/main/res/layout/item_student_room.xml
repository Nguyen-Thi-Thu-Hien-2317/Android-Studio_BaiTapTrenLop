<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="17dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="13dp">

        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="49dp"
            android:layout_height="49dp"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:text="A"
            android:textColor="@color/teal_900"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/navy_900"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="2" />
            <TextView
                android:id="@+id/tvStudentCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/slate_600"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/slate_600"
                android:textSize="13sp"
                android:ellipsize="end"
                android:maxLines="1" />
            <TextView
                android:id="@+id/tvMajor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/slate_600"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvGpa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_count"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/teal_900"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete_student"
            android:padding="12dp"
            android:src="@drawable/ic_delete"
            android:tint="@color/error_red" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
